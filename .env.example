# Copy to .env and adjust if needed. No real secrets belong in this file or
# in .env — see CLAUDE.md ("no secrets in logs or code").

# Matches docker-compose.yml's postgres service.
DATABASE_URL=postgresql://gatekeeper:gatekeeper_dev@localhost:5432/gatekeeper

# minimal | pretty
LOG_LEVEL=info

# How often the worker checks for projects due a scheduled run.
WORKER_TICK_SECONDS=60
