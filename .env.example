# Copy to .env and adjust if needed. No real secrets belong in this file or
# in .env — see CLAUDE.md ("no secrets in logs or code").

# Matches docker-compose.yml's postgres service.
DATABASE_URL=postgresql://gatekeeper:gatekeeper_dev@localhost:5432/gatekeeper

# minimal | pretty
LOG_LEVEL=info

# How often the worker checks for projects due a scheduled run. Each project
# sets its own cadence in its gatekeeper.json; this is only how often the
# worker looks.
WORKER_TICK_SECONDS=60

# How long captured gate output is kept, in days. Gate results themselves are
# never deleted — they are the flake evidence — but their output is most of
# the bytes and has a short useful life. 0 keeps output forever.
OUTPUT_RETENTION_DAYS=30
