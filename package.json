{
  "name": "hoosradar",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean && rimraf packages/*/dist",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "migrate": "npm run migrate -w @hoosradar/db",
    "migrate:down": "npm run migrate:down -w @hoosradar/db",
    "seed": "npm run seed -w @hoosradar/db",
    "dev:web": "npm run dev -w @hoosradar/web",
    "dev:worker": "npm run dev -w @hoosradar/worker"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.10.2",
    "dotenv": "17.4.2",
    "node-pg-migrate": "9.0.0",
    "rimraf": "6.1.3",
    "typescript": "5.7.2",
    "vitest": "4.1.11"
  }
}
