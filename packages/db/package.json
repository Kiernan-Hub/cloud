{
  "name": "@hoosradar/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node-pg-migrate up --migrations-dir migrations --envPath ../../.env",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations --envPath ../../.env",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@hoosradar/core": "*",
    "dotenv": "17.4.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "node-pg-migrate": "9.0.0",
    "tsx": "4.23.13"
  }
}
